generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  PATIENT
  CARE_GIVER
  ADMIN
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                    Int          @id @default(autoincrement())
  name                  String
  email                 String       @unique
  password              String
  role                  Role         @default(PATIENT)
  isBlock               Boolean      @default(false)
  latitude              Float?
  longitude             Float?
  createdAt             DateTime     @default(now())
  patientAssignments    Assignment[] @relation("PatientAssignments")
  careGiverAssignments  Assignment[] @relation("CareGiverAssignments")

}

model Assignment {
  id          Int              @id @default(autoincrement())
  patientId   Int
  careGiverId Int?
  type        String           @default("NORMAL")
  status      AssignmentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  patient     User             @relation("PatientAssignments", fields: [patientId], references: [id])
  careGiver   User?            @relation("CareGiverAssignments", fields: [careGiverId], references: [id])
}